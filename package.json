{
  "name": "reach-presenter",
  "version": "0.1.0",
  "description": "Presentation software for Reach Church",
  "main": "./out/main/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "electron-vite dev -- --no-sandbox",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "fflate": "^0.8.3",
    "nanoid": "^6.0.2",
    "protobufjs": "^8.8.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.2",
    "zustand": "^5.1.0"
  },
  "productName": "Reach Presenter",
  "build": {
    "appId": "church.reach.presenter",
    "productName": "Reach Presenter",
    "files": [
      "out/**",
      "resources/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "fileAssociations": [
      {
        "ext": "reach",
        "name": "Reach Presentation"
      },
      {
        "ext": "reachbundle",
        "name": "Reach Bundle"
      }
    ],
    "linux": {
      "icon": "resources/icon-square.png"
    }
  },
  "private": true
}
